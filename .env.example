# --- URL publique du build (DNS interne avec sous-chemin) ---
# Ex. site servi en https://intranet.chu/radio-archive/ → définir :
# VITE_BASE_PATH=/radio-archive/
# Laisser vide ou commenté pour servir à la racine du domaine.

# --- Gemini (API existante) ---
GEMINI_API_KEY=

# --- Connexion application (optionnel : si les 3 variables sont définies, écran de login obligatoire) ---
# Identifiant : libre (souvent votre adresse e-mail professionnelle, ex. prenom.nom@chu-example.fr)
AUTH_USERNAME=
# Mot de passe : vous choisissez le mot de passe, puis vous générez le hash :
#   npm run hash-password -- "LeMotDePasseQueVousAvezChoisi"
# Copiez la ligne AUTH_PASSWORD_BCRYPT_B64 dans ce fichier (recommandé, sans caractère $).
# AUTH_PASSWORD_BCRYPT_B64=
# AUTH_PASSWORD_BCRYPT=
# Secret pour signer le cookie de session (chaîne longue aléatoire, ex. openssl rand -hex 32)
AUTH_SESSION_SECRET=

# --- Multi-utilisateurs (optionnel) ---
# Si DATABASE_URL est défini, chaque personne a son propre compte (e-mail + mot de passe en base).
# Sinon, le couple AUTH_USERNAME + AUTH_PASSWORD_BCRYPT_B64 ci-dessus reste le mode « un seul compte ».
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Recommandé avec DATABASE_URL : inscription depuis l’app (« Créer un compte »)
# ALLOW_PUBLIC_REGISTRATION=true
# Si vous préférez fermer l’inscription : ALLOW_PUBLIC_REGISTRATION=false + AUTH_ADMIN_SECRET + POST /api/auth/admin/users
# AUTH_ADMIN_SECRET=

# --- Correspondance CASE ↔ IPP (serveur uniquement, jamais VITE_) ---

# URL HTTPS de VOTRE API sur le SI / HDS qui enregistre la table de correspondance
PATIENT_MAPPING_UPSTREAM_URL=https://api-votre-etablissement.fr/radio-archive/mapping

# Optionnel : Bearer vers l’API HDS (reste sur le serveur, pas dans le bundle)
PATIENT_MAPPING_UPSTREAM_KEY=

# Optionnel mais recommandé : même valeur saisie par l’utilisateur dans Réglages (session navigateur)
# pour autoriser le POST vers /api/patient-mapping
PATIENT_MAPPING_INBOUND_SECRET=

# mTLS optionnel vers l’HDS (1 = activé, certificat client requis)
# PATIENT_MAPPING_UPSTREAM_MTLS=1
# PATIENT_MAPPING_UPSTREAM_CLIENT_CERT=
# PATIENT_MAPPING_UPSTREAM_CLIENT_KEY=
# PATIENT_MAPPING_UPSTREAM_CA=
